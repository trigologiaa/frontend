rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is whoever has usuarios/{uid}.rol == "admin".
    // If the document does not exist, get() fails and the rule is denied.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    // Catalog: anyone reads it, only admins write it.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Roles: each person reads only their own document; the browser never writes.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Orders: anyone creates one, only admins read them.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
